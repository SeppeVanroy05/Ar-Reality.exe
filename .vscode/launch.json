{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Mobiel - Unity AR (iPhone / Android)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/ar_mobile",
      "program": "${workspaceFolder}/ar_mobile/lib/main.dart",
      "flutterMode": "release"
    },
    {
      "name": "Flutter-preview zonder AR - Chrome",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/lib/main.dart",
      "deviceId": "chrome"
    }
  ]
}
